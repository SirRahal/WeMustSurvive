  // Guided tutorial for Map 1. Each step: camera focus (grid coords) + zoom, instruction text,
  // optional command-card button to highlight, hint tiles to pulse, and a goal that advances the step.
  // Goals: null (player clicks Next), "engineerAt", "hintsBuilt", "furnaceSmelting", "platesDelivered",
  //        "nexusFilter", "turretArmed", "waveStarted".  Hint building "mark" = a plain marker ring.
  "steps": [
    {
      "id": "welcome",
      "title": "Welcome to The Funnel",
      "body": "Aliens have overrun the surface. This glowing block is the Nexus: it stores everything you mine and pays for everything you build. If it's destroyed, it's game over.\n\nThis tutorial walks you through your first factory. The alien waves are on hold until you're ready.",
      "focus": { "x": 40.5, "y": 64.5 }, "zoom": 1.3
    },
    {
      "id": "choke",
      "title": "Where they come from",
      "body": "Every wave squeezes through this gap at the top of the map and heads straight for your Nexus.\n\nMove the camera with WASD, the arrow keys, or by pushing the mouse to the screen edge. Scroll to zoom. Press C at any time to jump back to your engineer.",
      "focus": { "x": 40.5, "y": 9 }, "zoom": 0.9
    },
    {
      "id": "move",
      "title": "Your engineer",
      "body": "The blue figure with the green ring is your engineer, your only builder.\n\nRight-click the marked spot to walk there.",
      "focus": { "x": 42, "y": 60.5 }, "zoom": 1.6,
      "goal": "engineerAt",
      "hints": [ { "building": "mark", "x": 43, "y": 59 } ]
    },
    {
      "id": "coal_drill",
      "title": "Mine coal",
      "body": "Coal fuels your drills and furnaces.\n\nClick Burner Drill on the command card (or press 3), then left-click the marked coal tile. The arrow shows where the drill drops what it mines; press R to rotate if needed. Your engineer walks over and builds it.",
      "focus": { "x": 45, "y": 61 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [ { "building": "drill", "x": 44, "y": 60, "dir": "East" } ]
    },
    {
      "id": "iron_drill",
      "title": "Mine iron",
      "body": "Iron is your main building material. Place another Burner Drill on the marked iron tile, facing west, toward the empty tile between the two drills. That's where the furnace will go.",
      "focus": { "x": 45, "y": 61 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [ { "building": "drill", "x": 46, "y": 60, "dir": "West" } ]
    },
    {
      "id": "fuel_drill",
      "title": "Fuel the iron drill",
      "body": "Drills that aren't sitting on coal need coal delivered. Place a drill on the little coal seam just below the iron drill, facing north. It will feed coal straight into the iron drill.",
      "focus": { "x": 45, "y": 61 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [ { "building": "drill", "x": 46, "y": 61, "dir": "North" } ]
