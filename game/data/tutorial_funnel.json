{
  // Guided tutorial for Map 1. Each step: camera focus (grid coords) + zoom, instruction text,
  // optional command-card button to highlight, hint tiles to pulse, and a goal that advances the step.
  // Goals: null (player clicks Next), "engineerAt", "hintsBuilt", "furnaceSmelting", "platesDelivered",
  //        "nexusFilter", "turretArmed", "waveStarted".  Hint building "mark" = a plain marker ring.
  "steps": [
    {
      "id": "welcome",
      "title": "Welcome to The Funnel",
      "body": "Aliens have overrun the surface. This glowing block is the Nexus: it stores everything you mine and pays for everything you build. If it's destroyed, it's game over.\n\nThis tutorial walks you through your first factory. The alien waves are on hold until you're ready.",
      "focus": { "x": 40.5, "y": 64.5 }, "zoom": 1.3
    },
    {
      "id": "choke",
      "title": "Where they come from",
      "body": "Every wave squeezes through this gap at the top of the map and heads straight for your Nexus.\n\nMove the camera with WASD, the arrow keys, or by pushing the mouse to the screen edge. Scroll to zoom. Press C at any time to jump back to your engineer.",
      "focus": { "x": 40.5, "y": 9 }, "zoom": 0.9
    },
    {
      "id": "move",
      "title": "Your engineer",
      "body": "The blue figure with the green ring is your engineer, your only builder.\n\nRight-click the marked spot to walk there.",
      "focus": { "x": 42, "y": 60.5 }, "zoom": 1.6,
      "goal": "engineerAt",
      "hints": [ { "building": "mark", "x": 43, "y": 59 } ]
    },
    {
      "id": "coal_drill",
      "title": "Mine coal",
      "body": "Coal is fuel for drills, furnaces and generators.\n\nIn the build panel (bottom) open the Production tab (or press 2), then pick Burner Drill (1) and left-click the marked coal tile. Drills aim themselves at the best neighbour; the arrow shows where it will drop what it mines (R to rotate). Your engineer walks over and builds it.",
      "focus": { "x": 45, "y": 61 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [ { "building": "drill", "x": 44, "y": 60, "dir": "East" } ]
    },
    {
      "id": "iron_drill",
      "title": "Mine iron",
      "body": "Iron is your main building material. Place another Burner Drill on the marked iron tile, facing west, toward the empty tile between the two drills. That's where the furnace will go.\n\nDrills on iron burn coal too, but you don't need to deliver it: burner buildings take coal from the Nexus automatically when they run low.",
      "focus": { "x": 45, "y": 61 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [ { "building": "drill", "x": 46, "y": 60, "dir": "West" } ]
    },
    {
      "id": "furnace",
      "title": "Smelt iron",
      "body": "A Furnace turns ore into plates. Build one (Production > Furnace, keys 2 then 2) on the marked tile.\n\nThe iron drill feeds it ore and the coal drill feeds it fuel. You'll see it glow when it starts smelting.",
      "focus": { "x": 45, "y": 61 }, "zoom": 1.9,
      "goal": "furnaceSmelting", "button": "furnace",
      "hints": [ { "building": "furnace", "x": 45, "y": 60 } ]
    },
    {
      "id": "inserter_out",
      "title": "Grab the plates",
      "body": "Plates pile up inside the furnace. An Inserter grabs items from the tile behind it and drops them on the tile in front.\n\nPlace one (Logistics > Inserter, keys 1 then 2) on the marked tile below the furnace, facing south.",
      "focus": { "x": 43.5, "y": 62 }, "zoom": 1.7,
      "goal": "hintsBuilt", "button": "inserter",
      "hints": [ { "building": "inserter", "x": 45, "y": 61, "dir": "South" } ]
    },
    {
      "id": "belts",
      "title": "Bring the plates home",
      "body": "Now lay Belts (Logistics > Belt, keys 1 then 1) along the marked path from the inserter into the Nexus.\n\nTip: hold the left mouse button and drag to lay a line of belts. The arrows show which way each belt runs.",
      "focus": { "x": 43.5, "y": 62 }, "zoom": 1.7,
      "goal": "platesDelivered", "count": 3, "button": "belt",
      "hints": [
        { "building": "belt", "x": 45, "y": 62, "dir": "South" },
        { "building": "belt", "x": 45, "y": 63, "dir": "West" },
        { "building": "belt", "x": 44, "y": 63, "dir": "West" },
        { "building": "belt", "x": 43, "y": 63, "dir": "West" },
        { "building": "belt", "x": 42, "y": 63, "dir": "West" }
      ]
    },
    {
      "id": "coal_home",
      "title": "Keep the coal coming",
      "body": "Burner drills, furnaces and generators pull coal from the Nexus whenever they run low, so the Nexus needs a steady supply.\n\nPlace a Burner Drill on the small coal seam (marked) facing south, then one Belt next to it facing west. It joins your plate line, so coal rides home with the plates. Hold Shift to queue both.",
      "focus": { "x": 44.5, "y": 62 }, "zoom": 1.8,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [
        { "building": "drill", "x": 46, "y": 61, "dir": "South" },
        { "building": "belt", "x": 46, "y": 62, "dir": "West" }
      ]
    },
    {
      "id": "factory_info",
      "title": "Your first factory",
      "body": "Iron plates and coal are flowing into the Nexus. Watch the counts in the top right; click them for the full storage list. Everything you build is paid from that storage, so a growing factory means more defenses.\n\nLeft-click any building to select it. Its details and actions (rotate, repair, deconstruct) replace the build panel. Back returns to the tabs.",
      "focus": { "x": 43, "y": 62 }, "zoom": 1.4
    },
    {
      "id": "turret",
      "title": "Build a turret",
      "body": "Gun Turrets shoot aliens automatically, but only while they have ammo. Build one (Turrets > Gun Turret, keys 5 then 1) on the marked tile beside the Nexus.\n\nNext you'll set up a little ammo factory to keep it loaded.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "goal": "hintsBuilt", "button": "gun_turret",
      "hints": [ { "building": "gun_turret", "x": 37, "y": 63 } ]
    },
    {
      "id": "workshop",
      "title": "Build an ammo workshop",
      "body": "The Munitions Works turns 2 iron plates into an ammo magazine. Build one (Production > Munitions Works, keys 2 then 3) on the marked tile, two tiles below the turret.\n\nThen hold Shift and place an Inserter (Logistics > Inserter, keys 1 then 2) on the marked tile between the Nexus and the workshop, facing west. It carries iron plates out of the Nexus into the workshop.\n\nShift chains orders: your engineer builds the workshop first, then the inserter. Without Shift, a new order replaces the engineer's plan.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "goal": "hintsBuilt", "button": "workshop",
      "hints": [
        { "building": "workshop", "x": 37, "y": 65 },
        { "building": "inserter", "x": 38, "y": 65, "dir": "West" }
      ]
    },
    {
      "id": "filter",
      "title": "What inserters carry",
      "body": "Inserters carry any item the building in front can use. This one takes iron plates out of the Nexus because that's all the workshop accepts.\n\nClick the inserter (marked) to see its options. A filter limits it to one item, and Auto filter picks one for you. Taking from the Nexus onto a belt needs a filter, or it would empty your storage. Click Next when you're ready.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "button": "filter:",
      "hints": [ { "building": "mark", "x": 38, "y": 65 } ]
    },
    {
      "id": "arm_turret",
      "title": "Feed the turret",
      "body": "Last link: place an Inserter on the marked tile between the workshop and the turret, facing north. It moves fresh magazines from the workshop into the turret.\n\nThe step completes when the turret has ammo. Click the turret to see its ammo count.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "goal": "turretArmed", "button": "inserter",
      "hints": [ { "building": "inserter", "x": 37, "y": 64, "dir": "North" } ]
    },
    {
      "id": "walls",
      "title": "Put up walls",
      "body": "Your turret is armed! Now protect it. Walls soak up damage and force aliens to walk around them, or chew through.\n\nPick Walls > Basic Wall (keys 4 then 1) and drag across the marked tiles in front of your turret.",
      "focus": { "x": 36.5, "y": 58 }, "zoom": 1.5,
      "goal": "hintsBuilt", "button": "wall",
      "hints": [
        { "building": "wall", "x": 34, "y": 59 },
        { "building": "wall", "x": 35, "y": 59 },
        { "building": "wall", "x": 36, "y": 59 },
        { "building": "wall", "x": 37, "y": 59 },
        { "building": "wall", "x": 38, "y": 59 }
      ]
    },
    {
      "id": "release",
      "title": "Here they come",
      "body": "That's the basics! The wave timer is now running (top left). Click the call-wave button next to it to start the first wave now, or use the time to keep building.\n\nDuring a fight, right-click damaged buildings to repair them.",
      "focus": { "x": 40.5, "y": 58 }, "zoom": 1.0,
      "goal": "waveStarted", "releaseWaves": true, "button": "call_wave"
    },
    {
      "id": "good_luck",
      "title": "Hold the Funnel",
      "body": "Survive all 10 waves to win. Next steps: build a Laboratory and press T to research Electricity, then mine the copper halfway up the arms. Later waves bring Brutes, acid-spitting Spitters and Sappers that blow up belts and power. The silver claim zone behind the choke mines twice as fast.\n\nGood luck, Engineer.",
      "focus": { "x": 40.5, "y": 58 }, "zoom": 1.0
    }
  ]
}
