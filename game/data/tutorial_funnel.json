    {
      "id": "release",
      "title": "Here they come",
      "body": "That's the basics! The wave timer is now running (top left). Click the call-wave button next to it to start the first wave now, or use the time to keep building.\n\nDuring a fight, right-click damaged buildings to repair them.",
      "focus": { "x": 40.5, "y": 58 }, "zoom": 1.0,
      "goal": "waveStarted", "releaseWaves": true, "button": "call_wave"
