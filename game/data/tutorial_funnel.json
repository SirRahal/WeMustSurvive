{
  // Guided tutorial for Map 1. Each step: camera focus (grid coords) + zoom, instruction text,
  // optional command-card button to highlight, hint tiles to pulse, and a goal that advances the step.
  // Goals: null (player clicks Next), "engineerAt", "hintsBuilt", "furnaceSmelting", "platesDelivered",
  //        "nexusFilter", "turretArmed", "waveStarted".  Hint building "mark" = a plain marker ring.
  "steps": [
    {
      "id": "welcome",
      "title": "Welcome to The Funnel",
      "body": "Aliens have overrun the surface. This glowing block is the Nexus: it stores everything you mine and pays for everything you build. If it's destroyed, it's game over.\n\nThis tutorial walks you through your first factory. The alien waves are on hold until you're ready.",
      "focus": { "x": 40.5, "y": 64.5 }, "zoom": 1.3
    },
    {
      "id": "choke",
      "title": "Where they come from",
      "body": "Every wave squeezes through this gap at the top of the map and heads straight for your Nexus.\n\nMove the camera with WASD, the arrow keys, or by pushing the mouse to the screen edge. Scroll to zoom. Press C at any time to jump back to your engineer.",
      "focus": { "x": 40.5, "y": 9 }, "zoom": 0.9
    },
    {
      "id": "move",
      "title": "Your engineer",
      "body": "The blue figure with the green ring is your engineer, your only builder.\n\nRight-click the marked spot to walk there.",
      "focus": { "x": 42, "y": 60.5 }, "zoom": 1.6,
      "goal": "engineerAt",
      "hints": [ { "building": "mark", "x": 43, "y": 59 } ]
    },
    {
      "id": "coal_drill",
      "title": "Mine coal",
      "body": "Coal is fuel for burner drills, furnaces and generators. They only burn coal that is delivered to them.\n\nIn the build panel (bottom) open the Production tab (or press 2), then pick Burner Drill (1) and left-click the marked coal tile, facing east. Drills aim themselves at the best neighbour; the arrow shows where it will drop what it mines (R to rotate). Your engineer walks over and builds it.",
      "focus": { "x": 47.5, "y": 61.5 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [ { "building": "drill", "x": 46, "y": 61, "dir": "East" } ]
    },
    {
      "id": "iron_drill",
      "title": "Mine iron",
      "body": "Iron is your main building material. Place another Burner Drill on the marked iron tile, facing south, toward the open ground below it. That's where the furnace will go.\n\nA drill on iron needs coal delivered to it. Hold Shift and place a third Burner Drill on the small coal seam just to its right, facing west: it mines coal straight into the iron drill. (Drills on coal fuel themselves.)",
      "focus": { "x": 47.5, "y": 61.5 }, "zoom": 1.9,
      "goal": "hintsBuilt", "button": "drill",
      "hints": [
        { "building": "drill", "x": 48, "y": 60, "dir": "South" },
        { "building": "drill", "x": 49, "y": 60, "dir": "West" }
      ]
    },
    {
      "id": "furnace",
      "title": "Smelt iron",
      "body": "A Furnace turns ore into plates. Build one (Production > Furnace, keys 2 then 2) on the marked spot. Machines are 3x3, so several drills and inserters can work each side.\n\nThe iron drill feeds it ore from above and the coal drill feeds it fuel from the left. You'll see it glow when it starts smelting.",
      "focus": { "x": 48, "y": 62 }, "zoom": 1.7,
      "goal": "furnaceSmelting", "button": "furnace",
      "hints": [ { "building": "furnace", "x": 47, "y": 61 } ]
    },
    {
      "id": "inserter_out",
      "title": "Grab the plates",
      "body": "Plates pile up inside the furnace. An Inserter grabs items from behind it (reaching over a belt if one is in the way) and drops them on the tile in front.\n\nPlace one (Logistics > Inserter, keys 1 then 2) on the marked tile left of the furnace, facing west.",
      "focus": { "x": 45, "y": 63 }, "zoom": 1.7,
      "goal": "hintsBuilt", "button": "inserter",
      "hints": [ { "building": "inserter", "x": 46, "y": 63, "dir": "West" } ]
    },
    {
      "id": "belts",
      "title": "Bring the plates home",
      "body": "Now lay Belts (Logistics > Belt, keys 1 then 1) along the marked path from the inserter into the Nexus.\n\nTip: hold the left mouse button and drag to lay a line of belts. The arrows show which way each belt runs.",
      "focus": { "x": 44, "y": 63 }, "zoom": 1.7,
      "goal": "platesDelivered", "count": 3, "button": "belt",
      "hints": [
        { "building": "belt", "x": 45, "y": 63, "dir": "West" },
        { "building": "belt", "x": 44, "y": 63, "dir": "West" },
        { "building": "belt", "x": 43, "y": 63, "dir": "West" },
        { "building": "belt", "x": 42, "y": 63, "dir": "West" }
      ]
    },
    {
      "id": "factory_info",
      "title": "Your first factory",
      "body": "Iron plates are flowing into the Nexus. Watch the counts in the top right; click them for the full storage list. Everything you build is paid from that storage, so a growing factory means more defenses.\n\nLeft-click any building to select it. Its details and actions (rotate, repair, deconstruct) replace the build panel. Back returns to the tabs.",
      "focus": { "x": 43, "y": 62 }, "zoom": 1.4
    },
    {
      "id": "turret",
      "title": "Build a turret",
      "body": "Gun Turrets shoot aliens automatically, but only while they have ammo. Build one (Turrets > Gun Turret, keys 5 then 1) on the marked tile beside the Nexus.\n\nNext you'll set up a little ammo factory to keep it loaded.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "goal": "hintsBuilt", "button": "gun_turret",
      "hints": [ { "building": "gun_turret", "x": 37, "y": 63 } ]
    },
    {
      "id": "workshop",
      "title": "Build an ammo workshop",
      "body": "The Munitions Works turns 2 iron plates into an ammo magazine. Build one (Production > Munitions Works, keys 2 then 3) on the marked spot below the turret.\n\nThen hold Shift and place an Inserter (Logistics > Inserter, keys 1 then 2) on the marked tile between the Nexus and the workshop, facing west. It carries iron plates out of the Nexus into the workshop.\n\nShift chains orders: your engineer builds the workshop first, then the inserter. Without Shift, a new order replaces the engineer's plan.",
      "focus": { "x": 37.5, "y": 65 }, "zoom": 1.6,
      "goal": "hintsBuilt", "button": "workshop",
      "hints": [
        { "building": "workshop", "x": 35, "y": 65 },
        { "building": "inserter", "x": 38, "y": 65, "dir": "West" }
      ]
    },
    {
      "id": "filter",
      "title": "What inserters carry",
      "body": "Inserters carry any item the building in front can use. This one takes iron plates out of the Nexus because that's all the workshop accepts.\n\nClick the inserter (marked) to see its options. A filter limits it to one item, and Auto filter picks one for you. Taking from the Nexus onto a belt needs a filter, or it would empty your storage.\n\nThis is also how you fuel machines from storage: an inserter from the Nexus (or a Storage Depot) into a furnace, drill or generator carries coal into it. Click Next when you're ready.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "button": "filter:",
      "hints": [ { "building": "mark", "x": 38, "y": 65 } ]
    },
    {
      "id": "arm_turret",
      "title": "Feed the turret",
      "body": "Last link: place an Inserter on the marked tile between the workshop and the turret, facing north. It moves fresh magazines from the workshop into the turret.\n\nThe step completes when the turret has ammo. Click the turret to see its ammo count.",
      "focus": { "x": 38, "y": 64.5 }, "zoom": 1.8,
      "goal": "turretArmed", "button": "inserter",
      "hints": [ { "building": "inserter", "x": 37, "y": 64, "dir": "North" } ]
    },
    {
      "id": "walls",
      "title": "Put up walls",
      "body": "Your turret is armed! Now protect it. Walls soak up damage and force aliens to walk around them, or chew through.\n\nPick Walls > Basic Wall (keys 4 then 1) and drag across the marked tiles in front of your turret.",
      "focus": { "x": 36.5, "y": 58 }, "zoom": 1.5,
      "goal": "hintsBuilt", "button": "wall",
      "hints": [
        { "building": "wall", "x": 34, "y": 59 },
        { "building": "wall", "x": 35, "y": 59 },
        { "building": "wall", "x": 36, "y": 59 },
        { "building": "wall", "x": 37, "y": 59 },
        { "building": "wall", "x": 38, "y": 59 }
      ]
